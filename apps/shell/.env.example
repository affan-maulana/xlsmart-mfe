# --- shell ---------------------------------------------------------------
# The shell holds no credentials. It links to the auth application for sign-in
# and sign-out, and reads identity over that application's session contract.
#   AUTH_APP_URL     - browser-facing base URL   (dev: http://localhost:3004/auth)
#   AUTH_SESSION_URL - server-to-server identity contract
# Production, both behind NGINX:
#   AUTH_APP_URL=/auth   AUTH_SESSION_URL=http://auth-app:3004/auth/api/session
AUTH_APP_URL=http://localhost:3004/auth
AUTH_SESSION_URL=http://localhost:3004/auth/api/session

# Absolute origin this application is reachable from, used to build the
# post-login return target. Required in EVERY environment - a relative target is
# refused by the auth service. Production: https://app.company.com
PUBLIC_APP_URL=http://localhost:3000

# Machine-to-machine address of the Queue application's own summary BFF.
# This is the only queue data the shell reads.
QUEUE_SUMMARY_URL=http://localhost:3002/queue/api/summary

# Browser-facing addresses of the independently deployed domain applications.
# In production these become same-origin sub-paths behind NGINX:
#   CUSTOMER360_URL=/customer360  QUEUE_URL=/queue  PRETOPOST_URL=/pretopost
CUSTOMER360_URL=http://localhost:3001/customer360
QUEUE_URL=http://localhost:3002/queue
PRETOPOST_URL=http://localhost:3003/pretopost
