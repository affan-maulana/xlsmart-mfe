# --- auth ----------------------------------------------------------------
# The Go auth service (separate repository). This application is its only
# frontend client: no other application may call it or read AUTH_API_URL.
AUTH_API_URL=http://localhost:8080

# Where a visitor lands when no usable ?next= was supplied. Absolute, because a
# relative target would be resolved against this application's own basePath.
DEFAULT_RETURN_URL=http://localhost:3000/

# The platform's own origins. Return targets must be absolute (see below), so
# this must list this environment's public origin too - production needs
# ALLOWED_RETURN_ORIGINS=https://app.company.com. It is an allowlist of *our*
# origins, not a wildcard: anything else falls back to DEFAULT_RETURN_URL.
ALLOWED_RETURN_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
