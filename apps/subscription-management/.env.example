# --- Subscription Management --------------------------------------------------
# Own Go backend for the Subscription Management domain.
SUBSCRIPTION_MANAGEMENT_API_URL=http://localhost:8083

# Identity lives in the auth application. Unauthenticated visitors are sent
# there to sign in. Production, behind NGINX: AUTH_APP_URL=/auth
AUTH_APP_URL=http://localhost:3004/auth

# Server-to-server identity contract (packages/auth getSession). Reads the
# incoming cookie and returns whitelisted profile fields.
# Production, behind NGINX: AUTH_SESSION_URL=/auth/api/session
AUTH_SESSION_URL=http://localhost:3004/auth/api/session

# Absolute origin this application is reachable from, used to build the
# post-login return target (each app appends its own basePath).
# Production: https://app.company.com
PUBLIC_APP_URL=http://localhost:3003

# The shell owns global navigation; this feeds the "back to dashboard" link.
# Production: leave EMPTY (same origin).
SHELL_URL=http://localhost:3000
