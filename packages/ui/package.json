{
  "name": "@repo/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared presentational UI primitives. No business logic, no domain components.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
